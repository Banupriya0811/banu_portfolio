# Server-side Supabase credentials (set these in Vercel Environment Variables and local .env)
# NEVER prefix secret keys with VITE_ — keep all credentials strictly server-side.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Only used strictly on the server if needed (never exposed to browser)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

